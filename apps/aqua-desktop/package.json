{
  "name": "aqua-desktop",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "aqua": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/start-aqua.ps1",
    "build": "tsc && vite build",
    "test": "node --test tests/*.test.ts",
    "test:integration": "node --test tests/falkorIntegration.test.ts",
    "lint": "tsc --noEmit",
    "lint:switch": "tsc -p tsconfig.switch.json",
    "switch:register": "node switch/register.ts",
    "switch:agent": "node switch/run.ts",
    "switch:simulate": "node switch/simulate.ts",
    "switch:chat": "node switch/interactiveChat.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "falkordb": "^6.8.0",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.2.2",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6"
  }
}
