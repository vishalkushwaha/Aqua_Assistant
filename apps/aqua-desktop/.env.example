# Copy this file to .env and provide your FalkorDB connection values.
# Never commit the populated .env file.
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_USER=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=AquaCompanyBrain
FALKORDB_TLS=false
# Keep this false for local FalkorDB. Set true only when a trusted remote
# endpoint does not offer TLS and you accept that transport risk.
FALKORDB_ALLOW_INSECURE_REMOTE=false

# Switch Rooms agent protocol. Create the agent with `npm run switch:register`,
# then set the room id before starting it with `npm run switch:agent`.
SWITCH_BRIDGE_URL=http://127.0.0.1:8080
SWITCH_REGISTRATION_TOKEN=
SWITCH_ROOM_IDS=
# Optional overrides. Registration writes the issued credentials to the
# gitignored .switch-agent.json file, so these normally stay empty.
SWITCH_AGENT_ID=
SWITCH_AGENT_API_KEY=
SWITCH_AGENT_NAME=aqua-company-brain
# Optional second agent to mention after an approved incident assignment.
SWITCH_INCIDENT_AGENT_NAME=
