# Copy this file to .env and provide your FalkorDB connection values.
# Never commit the populated .env file.
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_USER=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=AquaCompanyBrain
FALKORDB_TLS=false
# Keep this false for local FalkorDB. Set true only when a trusted remote
# endpoint does not offer TLS and you accept that transport risk.
FALKORDB_ALLOW_INSECURE_REMOTE=false
